@startuml
skinparam linetype ortho
skinparam shadowing false
skinparam backgroundColor #FFFFFF
skinparam ArrowColor #343A40
left to right direction

package "data/warehouse.duckdb (Single-File DuckDB)" as DUCK #F8F9FA {
    database "Schema: stg (Transient Landing)" as STG #E9ECEF {
        rectangle "raw_steam, raw_itch, raw_vgen,\nraw_fiverr, raw_paypal, raw_fx_rates,\nraw_projects, raw_title_map\netl_rejects (quarantine)\n- No PK/FK constraints\n- Contains raw PII before drop" as STG_D #FFFFFF
    }

    database "Schema: edw (Core Star Schema)" as EDW #E8F5E9 {
        rectangle "dim_date (730 rows)\ndim_revenue_stream (3 rows)\ndim_currency (7 rows)\ndim_platform (5 rows)\ndim_project (12 rows)\nfact_revenue_event (5,911 rows)\nv_fact_enriched (view)\n- PK, 5 FKs, UNIQUE(transaction_code)\n- DECIMAL(18,2)/(18,6) & sign CHECKs" as EDW_D #FFFFFF
    }

    database "Schema: mart (Analytical Views)" as MART #E3F2FD {
        rectangle "v_revenue_monthly\nv_project_performance\nv_fee_refund_leakage\nv_fx_exposure\n- INT logic folded into ETL + views\n- Rebuilt via idempotent full refresh" as MART_D #FFFFFF
    }
}

STG --> EDW : Python ETL Transform
EDW --> MART : SQL Views
@enduml
